<?xml version="1.0" encoding="UTF-8"?>
<!--
  reportman.es — EL web.config DEL SITIO DE IIS DEL ANFITRION, no el de la web.

  DONDE VA: en la carpeta fisica del sitio nuevo de IIS del anfitrion Windows
  (p.ej. C:\inetpub\reportman-es\web.config), renombrado a `web.config`.

  QUE HACE FALTA ANTES:
    1. Sitio nuevo en IIS con una carpeta fisica vacia. La carpeta hace falta aunque no
       sirva contenido: ahi escribe win-acme el reto del certificado.
    2. Bindings de :80 para reportman.es y www.reportman.es.
    3. win-acme (wacs.exe) para LOS DOS nombres, que deja los bindings de :443 con SNI.
    4. Este fichero.
    5. Y el DNS: los registros A de reportman.es y www.reportman.es, de 91.134.113.42
       a 51.178.118.23.

  OJO CON EL CORREO: mail.reportman.es se queda en 91.134.113.42 con su propio registro A,
  asi que mover el apex y el www no lo toca. Pero por ahi entra info@reportman.es, que es
  el contacto declarado en la declaracion responsable: ese host no se puede apagar sin
  mover antes el buzon.

  ARR y URL Rewrite ya estan instalados en el anfitrion: lo demuestra el
  `X-Powered-By: ARR/3.0` que devuelve erpapp.reportman.es.
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>

        <!-- PRIMERA, Y CON stopProcessing. win-acme escribe el reto en la carpeta fisica de
             este sitio y valida por HTTP en el :80. Si esta regla no fuera la primera, el
             reto se iria al proxy (o a los redirects de abajo) y no habria renovacion: el
             certificado caducaria a los tres meses sin que nadie tocara nada. -->
        <rule name="ACME se queda en casa" stopProcessing="true">
          <match url="^\.well-known/acme-challenge/.*" />
          <action type="None" />
        </rule>

        <!-- EL CANONICO ES EL APEX, y no es una preferencia mia: lo dice la propia web en su
             `rel=canonical`, en su `og:url` y en las 541 URL de su sitemap, todas
             https://reportman.es/...

             ESTO CAMBIA LO QUE HACIA EL HOST VIEJO, y conviene saberlo: alli
             https://www.reportman.es/ devolvia 200 y servia el sitio, de modo que los dos
             nombres competian entre si mientras la pagina votaba por uno. Con este 301 (302
             mientras se prueba) el www deja de competir y sus enlaces entrantes se consolidan
             en el apex, que es lo que se buscaba al poner el canonical.

             VA ANTES DE LA DE HTTPS para que sea UN SOLO SALTO: http://www/x se va derecho a
             https://reportman.es/x en vez de pasar por https://www/x. -->
        <rule name="Al apex" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTP_HOST}" pattern="^www\.reportman\.es$" />
          </conditions>
          <action type="Redirect" url="https://reportman.es/{R:1}" redirectType="Found" />
        </rule>

        <!-- El host viejo ya forzaba HTTPS (http://reportman.es/ devolvia 301), asi que esto
             no es nuevo: es lo mismo que habia. En 302 mientras se prueba; cuando este visto,
             redirectType="Permanent" en esta y en la de arriba. -->
        <rule name="A HTTPS" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="^off$" />
          </conditions>
          <action type="Redirect" url="https://{HTTP_HOST}/{R:1}" redirectType="Found" />
        </rule>

        <!-- `Rewrite` A UNA URL http:// ES LO QUE ARR INTERCEPTA como proxy. Un `Redirect`
             mandaria al visitante a una IP privada que su navegador no alcanza.

             NO HACE FALTA TOCAR preserveHostHeader: cada web tiene su PUERTO en la VM
             (:5081 ai.reportman.es, :5082 erpaisoftware.com, :5083 esta), asi que el vhost
             de nginx no depende de la cabecera Host.

             Y NADA DE <serverVariables>: para una web estatica no hace falta ninguna, y cada
             una que se ponga hay que autorizarla ademas en «URL Rewrite -> View Server
             Variables» del SERVIDOR, o la regla devuelve un 500. -->
        <rule name="Proxy a la VM" stopProcessing="true">
          <match url="(.*)" />
          <action type="Rewrite" url="http://192.168.100.2:5083/{R:1}" />
        </rule>

      </rules>
    </rewrite>
  </system.webServer>
</configuration>
