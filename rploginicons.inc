// Writes to AStream the PNG of a login icon (google, microsoft, apple, email)
// of ASize pixels (20, 30 or 40); False when there is none
function RpLoginIconPng(const AName: string; ASize: Integer; AStream: TStream): Boolean;
begin
  Result := True;
  if (AName = 'google') and (ASize = 20) then
    AStream.WriteBuffer(RpLoginIcon_google_20, SizeOf(RpLoginIcon_google_20))
  else if (AName = 'google') and (ASize = 30) then
    AStream.WriteBuffer(RpLoginIcon_google_30, SizeOf(RpLoginIcon_google_30))
  else if (AName = 'google') and (ASize = 40) then
    AStream.WriteBuffer(RpLoginIcon_google_40, SizeOf(RpLoginIcon_google_40))
  else if (AName = 'microsoft') and (ASize = 20) then
    AStream.WriteBuffer(RpLoginIcon_microsoft_20, SizeOf(RpLoginIcon_microsoft_20))
  else if (AName = 'microsoft') and (ASize = 30) then
    AStream.WriteBuffer(RpLoginIcon_microsoft_30, SizeOf(RpLoginIcon_microsoft_30))
  else if (AName = 'microsoft') and (ASize = 40) then
    AStream.WriteBuffer(RpLoginIcon_microsoft_40, SizeOf(RpLoginIcon_microsoft_40))
  else if (AName = 'apple') and (ASize = 20) then
    AStream.WriteBuffer(RpLoginIcon_apple_20, SizeOf(RpLoginIcon_apple_20))
  else if (AName = 'apple') and (ASize = 30) then
    AStream.WriteBuffer(RpLoginIcon_apple_30, SizeOf(RpLoginIcon_apple_30))
  else if (AName = 'apple') and (ASize = 40) then
    AStream.WriteBuffer(RpLoginIcon_apple_40, SizeOf(RpLoginIcon_apple_40))
  else if (AName = 'email') and (ASize = 20) then
    AStream.WriteBuffer(RpLoginIcon_email_20, SizeOf(RpLoginIcon_email_20))
  else if (AName = 'email') and (ASize = 30) then
    AStream.WriteBuffer(RpLoginIcon_email_30, SizeOf(RpLoginIcon_email_30))
  else if (AName = 'email') and (ASize = 40) then
    AStream.WriteBuffer(RpLoginIcon_email_40, SizeOf(RpLoginIcon_email_40))
  else
    Result := False;
end;
