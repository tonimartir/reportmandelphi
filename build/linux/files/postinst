#!/bin/sh
# postinst de reportman-designer: registra el menu, el tipo MIME de *.rep y los
# iconos. En Debian/Ubuntu los disparadores (triggers) de desktop-file-utils,
# shared-mime-info y hicolor-icon-theme ya lo hacen; estas llamadas cubren los
# sistemas donde no esta instalado el paquete del disparador en ese momento.
set -e

if [ "$1" = "configure" ]; then
    if command -v update-desktop-database >/dev/null 2>&1; then
        update-desktop-database -q /usr/share/applications || true
    fi
    if command -v update-mime-database >/dev/null 2>&1; then
        update-mime-database /usr/share/mime || true
    fi
    if command -v gtk-update-icon-cache >/dev/null 2>&1 \
       && [ -f /usr/share/icons/hicolor/index.theme ]; then
        gtk-update-icon-cache -q -t -f /usr/share/icons/hicolor || true
    fi
fi

exit 0
