function HexToStream(const HexStr: string): TMemoryStream;
var
  len, i, posByte: Integer;
  b: array of Byte;
  c1, c2: Char;

  function HexNibble(c: Char): Byte;
  begin
    case c of
      '0'..'9': Result := Ord(c) - Ord('0');
      'A'..'F': Result := Ord(c) - Ord('A') + 10;
      'a'..'f': Result := Ord(c) - Ord('a') + 10;
      else Result := 0;
    end;
  end;

begin
  Result := TMemoryStream.Create;
  len := Length(HexStr) div 2;
  if len <= 0 then Exit;
  b := nil;
  SetLength(b, len);
  posByte := 0;
  i := 1;
  while (i < Length(HexStr)) and (posByte < len) do
  begin
    c1 := HexStr[i];
    c2 := HexStr[i + 1];
    b[posByte] := (HexNibble(c1) shl 4) or HexNibble(c2);
    Inc(posByte);
    Inc(i, 2);
  end;
  Result.WriteBuffer(b[0], len);
  Result.Position := 0;
end;

procedure LoadDesignerImageList(AImageList: TImageList);
var
  i: Integer;
  ms: TMemoryStream;
  png: TPortableNetworkGraphic;
  bmp: TBitmap;
begin
  if not Assigned(AImageList) then Exit;
  AImageList.Clear;
  AImageList.Width := 20;
  AImageList.Height := 20;
  png := TPortableNetworkGraphic.Create;
  bmp := TBitmap.Create;
  try
    bmp.PixelFormat := pf32bit;
    for i := 0 to ICON_COUNT - 1 do
    begin
      ms := HexToStream(ICON_HEX[i]);
      try
        png.LoadFromStream(ms);
        bmp.Assign(png);
        AImageList.Add(bmp, nil);
      finally
        ms.Free;
      end;
    end;
  finally
    bmp.Free;
    png.Free;
  end;
end;

