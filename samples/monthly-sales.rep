<DATAINFO>
<ALIAS type="String">MON</ALIAS>
<NAME type="String">TRpDataInfoItem0</NAME>
<DATABASEALIAS type="String">SAMPLES</DATABASEALIAS>
<SQL type="WideString">SELECT strftime(#39##37#Y#45##37#m#39##44#
 O.ORDER_DATE) AS PERIOD#44# substr(#39#J
anFebMarAprMayJunJulAugSepOctNovDec#39##44#
 (CAST(strftime(#39##37#m#39##44# O.ORDER
_DATE) AS INTEGER) #45# 1) #42# 3 #43# 1#44#
 3) #124##124# #39# #39# #124##124# strft
ime(#39##37#Y#39##44# O.ORDER_DATE) AS MO
NTH_NAME#44# COUNT(DISTINCT O.ORDER_ID) A
S ORDERS#44# SUM(L.QUANTITY) AS UNITS#44#
 SUM(L.QUANTITY#42#L.UNIT_PRICE#42#(1#45#
L.DISCOUNT#47#100.0)) AS SALES FROM ORDER
S O JOIN ORDER_LINES L ON L.ORDER_ID = O.
ORDER_ID WHERE O.ORDER_DATE BETWEEN date(
:FROM_DATE) AND date(:TO_DATE) GROUP BY 1
#44# 2 ORDER BY 1</SQL>
