<DATAINFO>
<ALIAS type="String">INV</ALIAS>
<NAME type="String">TRpDataInfoItem0</NAME>
<DATABASEALIAS type="String">SAMPLES</DATABASEALIAS>
<SQL type="WideString">SELECT O.ORDER_ID#44# O.ORDER_NUMBER#44# 
O.ORDER_DATE#44# O.STATUS#44# O.VAT_RATE#44#
 C.CODE AS CUSTOMER_CODE#44# C.COMPANY_NA
ME#44# C.CONTACT_NAME#44# C.ADDRESS#44# C
.POSTAL_CODE#44# C.CITY#44# C.COUNTRY#44#
 E.FIRST_NAME#44# E.LAST_NAME#44# L.LINE_
NO#44# P.SKU#44# P.NAME AS PRODUCT#44# P.
UNIT#44# L.QUANTITY#44# L.UNIT_PRICE#44# 
L.DISCOUNT FROM ORDERS O JOIN CUSTOMERS C
 ON C.CUSTOMER_ID = O.CUSTOMER_ID JOIN EM
PLOYEES E ON E.EMPLOYEE_ID = O.EMPLOYEE_I
D JOIN ORDER_LINES L ON L.ORDER_ID = O.OR
DER_ID JOIN PRODUCTS P ON P.PRODUCT_ID = 
L.PRODUCT_ID WHERE O.ORDER_ID BETWEEN :FI
RST_ORDER AND :LAST_ORDER ORDER BY O.ORDE
R_ID#44# L.LINE_NO</SQL>
