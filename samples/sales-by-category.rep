<DATAINFO>
<ALIAS type="String">PROD</ALIAS>
<NAME type="String">TRpDataInfoItem0</NAME>
<DATABASEALIAS type="String">SAMPLES</DATABASEALIAS>
<SQL type="WideString">SELECT C.NAME AS CATEGORY#44# P.SKU#44# P
.NAME AS PRODUCT#44# SUM(L.QUANTITY) AS U
NITS#44# SUM(L.QUANTITY#42#L.UNIT_PRICE#42#
(1#45#L.DISCOUNT#47#100.0)) AS SALES FROM
 ORDER_LINES L JOIN ORDERS O ON O.ORDER_I
D = L.ORDER_ID JOIN PRODUCTS P ON P.PRODU
CT_ID = L.PRODUCT_ID JOIN CATEGORIES C ON
 C.CATEGORY_ID = P.CATEGORY_ID WHERE CAST
(strftime(#39##37#Y#39##44# O.ORDER_DATE)
 AS INTEGER) = :SALES_YEAR GROUP BY C.NAM
E#44# P.SKU#44# P.NAME ORDER BY C.NAME#44#
 SALES DESC</SQL>
<DATASOURCE type="String"></DATASOURCE>
<MYBASEFILENAME type="String"></MYBASEFILENAME>
<MYBASEFIELDS type="String"></MYBASEFIELDS>
<MYBASEINDEXFIELDS type="String"></MYBASEINDEXFIELDS>
<MYBASEMASTERFIELDS type="String"></MYBASEMASTERFIELDS>
<BDEINDEXFIELDS type="String"></BDEINDEXFIELDS>
<BDEINDEXNAME type="String"></BDEINDEXNAME>
<BDETABLE type="String"></BDETABLE>
<BDETYPE type="Integer">0</BDETYPE>
<BDEFILTER type="String"></BDEFILTER>
<BDEMASTERFIELDS type="String"></BDEMASTERFIELDS>
<BDEFIRSTRANGE type="String"></BDEFIRSTRANGE>
<BDELASTRANGE type="String"></BDELASTRANGE>
