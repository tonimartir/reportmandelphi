<DATAINFO>
<ALIAS type="String">CATS</ALIAS>
<NAME type="String">TRpDataInfoItem1</NAME>
<DATABASEALIAS type="String">SAMPLES</DATABASEALIAS>
<SQL type="WideString">SELECT C.NAME AS CATEGORY#44# SUM(L.QUANT
ITY) AS UNITS#44# SUM(L.QUANTITY#42#L.UNI
T_PRICE#42#(1#45#L.DISCOUNT#47#100.0)) AS
 SALES#44# 100.0 #42# SUM(L.QUANTITY#42#L
.UNIT_PRICE#42#(1#45#L.DISCOUNT#47#100.0)
) #47# (SELECT SUM(L.QUANTITY#42#L.UNIT_P
RICE#42#(1#45#L.DISCOUNT#47#100.0)) FROM 
ORDER_LINES L JOIN ORDERS O ON O.ORDER_ID
 = L.ORDER_ID JOIN PRODUCTS P ON P.PRODUC
T_ID = L.PRODUCT_ID JOIN CATEGORIES C ON 
C.CATEGORY_ID = P.CATEGORY_ID WHERE CAST(
strftime(#39##37#Y#39##44# O.ORDER_DATE) 
AS INTEGER) = :SALES_YEAR ) AS SHARE FROM
 ORDER_LINES L JOIN ORDERS O ON O.ORDER_I
D = L.ORDER_ID JOIN PRODUCTS P ON P.PRODU
CT_ID = L.PRODUCT_ID JOIN CATEGORIES C ON
 C.CATEGORY_ID = P.CATEGORY_ID WHERE CAST
(strftime(#39##37#Y#39##44# O.ORDER_DATE)
 AS INTEGER) = :SALES_YEAR GROUP BY C.NAM
E ORDER BY SALES DESC</SQL>
