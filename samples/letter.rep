<ALIAS type="String">LET</ALIAS>
<NAME type="String">TRpDataInfoItem0</NAME>
<DATABASEALIAS type="String">SAMPLES</DATABASEALIAS>
<SQL type="WideString">SELECT C.CUSTOMER_ID#44# C.COMPANY_NAME#44#
 C.CONTACT_NAME#44# C.ADDRESS#44# C.POSTA
L_CODE#44# C.CITY#44# C.COUNTRY#44# C.CUS
TOMER_SINCE#44# (SELECT COUNT(#42#) FROM 
ORDERS O WHERE O.CUSTOMER_ID = C.CUSTOMER
_ID) AS ORDER_COUNT FROM CUSTOMERS C WHER
E C.CUSTOMER_ID BETWEEN :FIRST_CUSTOMER A
ND :LAST_CUSTOMER ORDER BY C.CUSTOMER_ID</SQL>
<DATASOURCE type="String"></DATASOURCE>
