<DATAINFO>
<ALIAS type="String">CATEGORY_FIRST</ALIAS>
<NAME type="String">TRpDataInfoItem0</NAME>
<DATABASEALIAS type="String">SAMPLES</DATABASEALIAS>
<SQL type="WideString">SELECT C.NAME AS CATEGORY#44# COUNT(DISTI
NCT O.ORDER_ID) AS ORDERS#44# SUM(L.QUANT
ITY#42#L.UNIT_PRICE#42#(1#45#L.DISCOUNT#47#
100.0)) AS SALES FROM ORDER_LINES L JOIN 
ORDERS O ON O.ORDER_ID = L.ORDER_ID JOIN 
PRODUCTS P ON P.PRODUCT_ID = L.PRODUCT_ID
 JOIN CATEGORIES C ON C.CATEGORY_ID = P.C
ATEGORY_ID WHERE CAST(strftime(#39##37#Y#39#
#44# O.ORDER_DATE) AS INTEGER) = :FIRST_Y
EAR GROUP BY C.NAME ORDER BY C.NAME</SQL>
<SCHEMANAME type="WideString">Sales</SCHEMANAME>
