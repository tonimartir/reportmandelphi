<ALIAS type="String">CAT</ALIAS>
<NAME type="String">TRpDataInfoItem0</NAME>
<DATABASEALIAS type="String">SAMPLES</DATABASEALIAS>
<SQL type="WideString">SELECT C.NAME AS CATEGORY#44# C.DESCRIPTI
ON AS CATEGORY_DESCRIPTION#44# P.SKU#44# 
P.EAN13#44# P.NAME#44# P.UNIT#44# P.UNIT_
PRICE#44# P.UNITS_IN_STOCK#44# P.REORDER_
LEVEL FROM PRODUCTS P JOIN CATEGORIES C O
N C.CATEGORY_ID = P.CATEGORY_ID ORDER BY 
C.NAME#44# P.NAME</SQL>
<SCHEMANAME type="WideString">Catalog</SCHEMANAME>
