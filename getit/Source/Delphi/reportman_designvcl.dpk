package reportman_designvcl;

{$R *.res}
{$IFDEF IMPLICITBUILDING This IFDEF should not be used by users}
{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO OFF}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION OFF}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES ON}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST OFF}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DEFINE COMPILINGREPMANPACKAGE}
{$DEFINE DEBUG}
{$ENDIF IMPLICITBUILDING}
{$DESCRIPTION 'Reportman VCL Designer'}
{$IMPLICITBUILD ON}

requires
  rtl,
  vclimg,
  vcl,
  vclx,
  reportman_rtl,
  reportman_vcl,
  designide;

contains
  rpmregdesignvcl in '..\Common\rpmregdesignvcl.pas',
  rpmdesignervcl in '..\Common\rpmdesignervcl.pas',
  rprulervcl in '..\Common\rprulervcl.pas',
  rpmdfmainvcl in '..\Common\rpmdfmainvcl.pas' {FRpMainFVCL},
  rpmdfdesignvcl in '..\Common\rpmdfdesignvcl.pas' {FRpDesignFrameVCL: TFrame},
  rpmdfstrucvcl in '..\Common\rpmdfstrucvcl.pas' {FRpStructureVCL: TFrame},
  rpdbbrowservcl in '..\Common\rpdbbrowservcl.pas' {FRpBrowserVCL: TFrame},
  rpmdobjinspvcl in '..\Common\rpmdobjinspvcl.pas' {FRpObjInspVCL: TFrame},
  rpmdobinsintvcl in '..\Common\rpmdobinsintvcl.pas',
  rpmdfextsecvcl in '..\Common\rpmdfextsecvcl.pas' {FRpExtSectionVCL},
  rpmdflabelintvcl in '..\Common\rpmdflabelintvcl.pas',
  rpmdfdrawintvcl in '..\Common\rpmdfdrawintvcl.pas',
  rpmdfbarcodeintvcl in '..\Common\rpmdfbarcodeintvcl.pas',
  rpmdfchartintvcl in '..\Common\rpmdfchartintvcl.pas',
  rpmdfsectionintvcl in '..\Common\rpmdfsectionintvcl.pas',
  rpmdfdinfovcl in '..\Common\rpmdfdinfovcl.pas' {FRpDInfoVCL},
  rpmdfdatasetsvcl in '..\Common\rpmdfdatasetsvcl.pas' {FRpDatasetsVCL: TFrame},
  rpfparamsvcl in '..\Common\rpfparamsvcl.pas' {FRpParamsVCL},
  rpmdfsampledatavcl in '..\Common\rpmdfsampledatavcl.pas' {FRpShowSampledataVCL},
  rpmdfdatatextvcl in '..\Common\rpmdfdatatextvcl.pas' {FRpDataTextVCL},
  rpmdfconnectionvcl in '..\Common\rpmdfconnectionvcl.pas' {FRpConnectionVCL: TFrame},
  rpdbxconfigvcl in '..\Common\rpdbxconfigvcl.pas' {FRpDBXConfigVCL},
  rpmdfgridvcl in '..\Common\rpmdfgridvcl.pas' {FRpGridOptionsVCL},
  rpmdsysinfo in '..\Common\rpmdsysinfo.pas' {FRpSysInfo},
  rpmdfopenlibvcl in '..\Common\rpmdfopenlibvcl.pas' {FRpOpenLibVCL},
  rpmdftreevcl in '..\Common\rpmdftreevcl.pas' {FRpDBTreeVCL: TFrame},
  rpeditconnvcl in '..\Common\rpeditconnvcl.pas' {FRpEditConVCL},
  rpmdfwizardvcl in '..\Common\rpmdfwizardvcl.pas' {FRpWizardVCL},
  rpmdfselectfields in '..\Common\rpmdfselectfields.pas' {FRpSelectFields: TFrame},
  rpcolumnar in '..\Common\rpcolumnar.pas',
  rppanel in '..\Common\rppanel.pas',
  rpdctransportchip in '..\Common\rpdctransportchip.pas',
  rpfrmlocalschemasvcl in '..\Common\rpfrmlocalschemasvcl.pas',
  rpfrmaischemaselectorvcl in '..\Common\rpfrmaischemaselectorvcl.pas',
  rpfrmmonacoeditorvcl in '..\Common\rpfrmmonacoeditorvcl.pas',
  rpmdcueviewvcl in '..\Common\rpmdcueviewvcl.pas',
  rpmdfnewreportwizardvcl in '..\Common\rpmdfnewreportwizardvcl.pas';

end.
