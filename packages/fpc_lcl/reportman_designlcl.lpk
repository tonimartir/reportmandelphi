<CONFIG>
  <Package Version="4">
    <PathDelim Value="\"/>
    <Name Value="reportman_designlcl"/>
    <Type Value="RunAndDesignTime"/>
    <Author Value="Toni Martir"/>
    <CompilerOptions>
      <Version Value="11"/>
      <PathDelim Value="\"/>
      <SearchPaths>
