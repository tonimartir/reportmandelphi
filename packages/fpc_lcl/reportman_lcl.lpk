<?xml version="1.0" encoding="UTF-8"?>
<CONFIG>
  <Package Version="4">
    <PathDelim Value="\"/>
    <Name Value="reportman_lcl"/>
    <Type Value="RunAndDesignTime"/>
    <Author Value="Toni Martir"/>
    <CompilerOptions>
      <Version Value="11"/>
      <PathDelim Value="\"/>
      <SearchPaths>
        <IncludeFiles Value="..\.."/>
        <OtherUnitFiles Value="..\..\lcl"/>
        <UnitOutputDirectory Value="lib\reportman_lcl\$(TargetCPU)-$(TargetOS)"/>
      </SearchPaths>
      <Parsing>
        <SyntaxOptions>
          <SyntaxMode Value="Delphi"/>
        </SyntaxOptions>
      </Parsing>
      <Other>
        <CustomOptions Value="-dLCL"/>
      </Other>
    </CompilerOptions>
    <Description Value="Report Manager LCL runtime: TLCLReport component, report preview window and preview control, page setup and parameters dialogs, and printing through Printer4Lazarus. Home page: https://reportman.es"/>
    <License Value="Mozilla Public License 1.1 (MPL), dual licensed: the GPL may be used instead. See LICENSE.TXT."/>
    <Version Major="4" Release="19"/>
    <Files Count="15">
      <Item1>
        <Filename Value="..\..\lcl\rplclfonts.pas"/>
        <UnitName Value="rplclfonts"/>
      </Item1>
      <Item2>
        <Filename Value="..\..\lcl\rpgraphutilslcl.pas"/>
        <UnitName Value="rpgraphutilslcl"/>
      </Item2>
      <Item3>
        <Filename Value="..\..\lcl\rpmaskedit.pas"/>
        <UnitName Value="rpmaskedit"/>
      </Item3>
      <Item4>
        <Filename Value="..\..\lcl\rplcldriver.pas"/>
        <UnitName Value="rplcldriver"/>
      </Item4>
      <Item5>
        <Filename Value="..\..\lcl\rprflclparams.pas"/>
        <UnitName Value="rprflclparams"/>
      </Item5>
      <Item6>
        <Filename Value="..\..\lcl\rppreviewmetalcl.pas"/>
        <UnitName Value="rppreviewmetalcl"/>
      </Item6>
      <Item7>
        <Filename Value="..\..\lcl\rppreviewcontrol.pas"/>
        <UnitName Value="rppreviewcontrol"/>
      </Item7>
      <Item8>
        <Filename Value="..\..\lcl\rppagesetuplcl.pas"/>
        <UnitName Value="rppagesetuplcl"/>
      </Item8>
      <Item9>
        <Filename Value="..\..\lcl\rplclpreview.pas"/>
        <UnitName Value="rplclpreview"/>
      </Item9>
      <Item10>
        <Filename Value="..\..\lcl\rplclreport.pas"/>
        <UnitName Value="rplclreport"/>
      </Item10>
      <Item11>
        <Filename Value="..\..\lcl\rpreglcl.pas"/>
        <HasRegisterProc Value="True"/>
        <UnitName Value="rpreglcl"/>
      </Item11>
      <Item12>
        <Filename Value="..\..\lcl\rpmdfembeddedfilelcl.pas"/>
        <UnitName Value="rpmdfembeddedfilelcl"/>
      </Item12>
      <Item13>
        <Filename Value="..\..\lcl\rpmdprintconfiglcl.pas"/>
        <UnitName Value="rpmdprintconfiglcl"/>
      </Item13>
      <Item14>
        <Filename Value="..\..\lcl\rplcllayout.pas"/>
        <UnitName Value="rplcllayout"/>
      </Item14>
      <Item15>
        <Filename Value="..\..\lcl\rpcocoaprint.pas"/>
        <UnitName Value="rpcocoaprint"/>
      </Item15>
    </Files>
    <RequiredPkgs Count="5">
      <Item1>
        <PackageName Value="reportman_rtl"/>
        <MinVersion Major="4" Release="19" Valid="True"/>
      </Item1>
      <Item2>
        <PackageName Value="LCL"/>
      </Item2>
      <Item3>
        <PackageName Value="Printer4Lazarus"/>
      </Item3>
      <Item4>
        <PackageName Value="FCL"/>
        <MinVersion Major="1" Valid="True"/>
      </Item4>
      <Item5>
        <PackageName Value="DateTimeCtrls"/>
      </Item5>
    </RequiredPkgs>
    <UsageOptions>
      <UnitPath Value="$(PkgOutDir)"/>
    </UsageOptions>
    <PublishOptions>
      <Version Value="2"/>
    </PublishOptions>
  </Package>
</CONFIG>
